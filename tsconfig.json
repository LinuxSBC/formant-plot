{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "outDir": "./dist",
    "rootDir": ".",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "allowJs": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "types": ["jqueryui", "vite/client"],
    "paths": {}
  },
  "include": [
    "**/*.ts",
    "node_modules/@types/jquery/misc.d.ts"
  ],
  "exclude": ["node_modules", "dist"]
}